# -----------------------------------------------------------------------------
# Frontend environment variables template.
# Copy this file to .env and fill in values.
# -----------------------------------------------------------------------------

# Origin + path prefix the API is served from. Defaults to /api in dev.
# VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Defaults to http://localhost:3000.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Google OAuth 2.0 Web Client ID for Google Identity Services.
# Must match GOOGLE_CLIENT_ID in the backend environment.
# Authorized JavaScript origin must include http://localhost:5173 for local development.
VITE_GOOGLE_CLIENT_ID=
